---
import Base from '../layouts/Base.astro';
---

<Base title="Something went wrong — teesh-art">
  <div class="error-page">
    <h1>Something went wrong</h1>
    <p class="detail">We hit an unexpected error. Please try again in a moment.</p>
    <div class="actions">
      <a href="/" class="home-link">← Back to shop</a>
      <a href="/cart" class="cart-link">View cart</a>
    </div>
  </div>
</Base>

<style>
  .error-page {
    text-align: center;
    padding: 4rem 1rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 0.75rem;
  }

  .detail {
    color: #666;
    margin-bottom: 2rem;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .home-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: #1a1a1a;
    color: #fff;
    border-radius: 6px;
    font-weight: 500;
    transition: background 0.2s;
  }

  .home-link:hover {
    background: #333;
  }

  .cart-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    font-weight: 500;
    color: #333;
    transition: border-color 0.2s;
  }

  .cart-link:hover {
    border-color: #999;
  }
</style>
