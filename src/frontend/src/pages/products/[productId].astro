---
import Base from '../../layouts/Base.astro';
import ProductActions from '../../components/ProductActions.tsx';

interface Product {
  productId: string;
  name: string;
  description: string;
  priceCents: number;
  images: string[];
  sizes: Record<string, { available: boolean }>;
}

export async function getStaticPaths() {
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

  try {
    const res = await fetch(`${API_URL}/products`);
    if (!res.ok) return [];
    const data = await res.json();
    const products: Product[] = data.products;

    return products.map((product) => ({
      params: { productId: product.productId },
      props: { product },
    }));
  } catch {
    return [];
  }
}

const { product } = Astro.props as { product: Product };

function formatPrice(cents: number): string {
  return `$${(cents / 100).toFixed(2)}`;
}
---

<Base title={`${product.name} — teesh-art`}>
  <a href="/" style="display: inline-block; margin-bottom: 1rem; color: #666;">← Back</a>

  <div class="product-detail">
    <img src={product.images[0]} alt={product.name} class="product-image" />
    <div class="product-info">
      <h1>{product.name}</h1>
      <p class="price">{formatPrice(product.priceCents)}</p>
      <p class="description">{product.description}</p>
      <ProductActions
        client:load
        productId={product.productId}
        name={product.name}
        priceCents={product.priceCents}
        image={product.images[0]}
        sizes={product.sizes}
      />
    </div>
  </div>
</Base>

<style>
  .product-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 600px) {
    .product-detail {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .product-image {
    width: 100%;
    border-radius: 8px;
  }

  .product-info h1 {
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
  }

  .price {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .description {
    color: #555;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 480px) {
    .product-info h1 {
      font-size: 1.25rem;
    }

    .price {
      font-size: 1.1rem;
    }
  }
</style>

<style is:global>
  .product-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .size-selector {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
  }

  .size-pill {
    min-width: 40px;
    height: 36px;
    padding: 0 0.75rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border: 1.5px solid #1a1a1a;
    background: transparent;
    color: #1a1a1a;
    transition: background 0.15s, color 0.15s;
  }

  .size-pill:hover:not(.size-pill--unavailable):not(.size-pill--selected) {
    background: #f0f0f0;
  }

  .size-pill--selected {
    background: #1a1a1a;
    color: #fff;
    border-color: #1a1a1a;
  }

  .size-pill--unavailable {
    background: #f0f0f0;
    color: #aaa;
    border-color: #e0e0e0;
    cursor: not-allowed;
  }

  .add-to-cart-btn {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }

  .add-to-cart-btn:hover:not(:disabled) {
    background: #333;
  }

  .add-to-cart-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .add-to-cart-btn--added {
    background: #22c55e;
  }

  .add-to-cart-btn--added:hover {
    background: #16a34a;
  }

  @media (max-width: 600px) {
    .add-to-cart-btn {
      width: 100%;
    }
  }

  .cart-qty-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .cart-qty-btn {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    border: 1px solid #ccc;
    background: #fff;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }

  .cart-qty-btn:hover {
    background: #f0f0f0;
  }

  .cart-qty-value {
    min-width: 1.5rem;
    text-align: center;
    font-weight: 600;
  }

  .cart-item-unit-price {
    margin-left: 0.5rem;
    color: #666;
  }
</style>

<script is:inline define:vars={{ productId: product.productId, productName: product.name, priceCents: product.priceCents }}>
  if (typeof gtag !== 'undefined') {
    gtag('event', 'view_item', {
      currency: 'USD',
      value: priceCents / 100,
      items: [{ item_id: productId, item_name: productName, price: priceCents / 100 }]
    });
  }
</script>
